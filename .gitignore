# .gitignore da Matriz
# Stack em docs/architecture.md (DA02, DA28). O backend/ e o frontend/ têm também o seu .gitignore.

# IDE e editores
.idea/
*.iml
.vscode/
*.swp
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Segredos e configuração local (IA01: nunca versionar credenciais)
.env
.env.*
!.env.example
*.pem
*.key

# Logs e ficheiros temporários
*.log
*.tmp
tmp/

# Backend (Maven, DA28)
backend/target/

# Frontend (Node, DA28)
frontend/node_modules/

# Build do frontend copiado para o backend (DA28): gera-se, não se versiona
backend/src/main/resources/static/
