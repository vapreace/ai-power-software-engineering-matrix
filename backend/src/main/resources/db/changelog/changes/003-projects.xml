<?xml version="1.0" encoding="UTF-8"?>
<!-- Tabela do módulo Projetos (docs/database.md, secção 3.4). -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-projects" author="matriz">
        <comment>Projetos (RF07, RF08, RF41, RN01, RN06, RN07, RN21, RN22, RN31, RN32, DA05, DA29).</comment>
        <createTable tableName="projects">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_projects"/>
            </column>
            <column name="team_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_projects_team" references="teams(id)"/>
            </column>
            <column name="manager_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_projects_manager" references="users(id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="expected_end_date" type="DATE"/>
            <column name="status" type="TEXT" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <sql>
            ALTER TABLE projects
                ADD CONSTRAINT ck_projects_name CHECK (char_length(name) BETWEEN 1 AND 100),
                ADD CONSTRAINT ck_projects_description CHECK (description IS NULL OR char_length(description) &lt;= 1000),
                ADD CONSTRAINT ck_projects_dates CHECK (expected_end_date IS NULL OR expected_end_date &gt;= start_date),
                ADD CONSTRAINT ck_projects_status CHECK (status IN ('ACTIVE', 'COMPLETED', 'ARCHIVED'))
        </sql>
        <createIndex tableName="projects" indexName="ix_projects_team">
            <column name="team_id"/>
        </createIndex>
        <createIndex tableName="projects" indexName="ix_projects_manager">
            <column name="manager_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="projects"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
