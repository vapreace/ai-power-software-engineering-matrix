# Configuração local da Matriz (DA30, DA38). Copiar para .env e ajustar.
# O .env não entra no Git (IA01). Estes valores são fictícios.

# Base de dados. MATRIZ_DB_HOST serve o backend em desenvolvimento (mvnw); dentro do Docker Compose,
# a aplicação usa sempre o serviço postgres. MATRIZ_DB_PORT é a porta do PostgreSQL nesta máquina.
MATRIZ_DB_HOST=localhost
MATRIZ_DB_PORT=5432
MATRIZ_DB_NAME=matriz
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=troque-esta-palavra-passe

# Primeira conta de Administrador, criada no arranque se não existir nenhuma (DA25).
# A palavra-passe é temporária (12 a 128 caracteres): é pedida uma nova na primeira entrada.
# Com o perfil demo não é usada, porque a Ana já é Administrador.
MATRIZ_ADMIN_NAME=Administrador
MATRIZ_ADMIN_EMAIL=admin@empresa.example
MATRIZ_ADMIN_PASSWORD=troque-esta-palavra-temporaria

# Docker Compose: perfis da aplicação (demo carrega os dados de demonstração; vazio, a base de
# dados fica vazia e entra o Administrador acima) e porta da aplicação nesta máquina.
MATRIZ_PROFILES=demo
MATRIZ_APP_PORT=8080
